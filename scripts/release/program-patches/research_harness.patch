@@ -0,0 +1,39 @@
+"""The reviewer role in cross-model review.
+
+The author side of a review (reading, fixing, rebutting, summarizing priors)
+runs on the caller's Runtime. Reviewer-side steps run through a ``Reviewer``
+Agent, usually configured with a different model so author and reviewer do
+not share blind spots::
+
+    reviewer = Reviewer(runtime=create_runtime(provider="openai-codex"))
+    review_loop(paper_dir, reviewer=reviewer)
+
+A Reviewer without its own Runtime reviews on the caller's.
+"""
+from __future__ import annotations
+
+from openprogram import Agent
+
+
+def current_runtime():
+    """The Runtime the current call runs on, if one is bound."""
+    from openprogram.agentic_programming.call_state import _current_runtime
+
+    return _current_runtime.get(None)
+
+
+def fresh_session(runtime) -> None:
+    """Drop a CLI Runtime's conversation so its next request starts clean."""
+    if hasattr(runtime, "reset"):
+        runtime.reset()
+
+
+class Reviewer(Agent):
+    def run(self, step, /, *args, **kwargs):
+        """Run one reviewer-side step on the reviewer's model."""
+        return step(*args, **kwargs)
+
+    @property
+    def effective_runtime(self):
+        """The reviewer's own Runtime, or the caller's when it has none."""
+        return self.runtime if self.runtime is not None else current_runtime()
