+# cross-model review: the configured Reviewer reaches review functions
+
+def test_reviewer_handed_to_functions_that_take_one(monkeypatch):
+    """The LLM never names `reviewer`; _stage_step passes the run's Reviewer."""
+    import research_harness.main as m
+    from research_harness.roles import Reviewer
+
+    seen = {}
+
+    def fake_review_loop(paper_dir="", reviewer=None):
+        seen["reviewer"] = reviewer
+        return {"passed": True}
+
+    avail = {"review_loop": {"function": fake_review_loop, "description": "r",
+                             "input": {}, "output": {}}}
+    monkeypatch.setattr(m, "build_stage_available", lambda stage: avail)
+    monkeypatch.setattr(m, "render_options", lambda a: "review_loop")
+    monkeypatch.setattr(m, "parse_args",
+                        lambda reply, av: (fake_review_loop, {}))
+
+    reviewer = Reviewer(runtime=MockRuntime("unused"))
+    rt = MockRuntime(_json({"call": "review_loop", "args": {}}))
+    out = call_with_runtime(
+        rt, _stage_step, stage="review", sub_task="x", context="",
+        reviewer=reviewer,
+    )
+    assert out["success"] is True
+    assert seen["reviewer"] is reviewer
