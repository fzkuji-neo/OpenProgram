+    pill_origin,
+    prefers_chinese,
+    status_text,
+    travel_duration,
+)
+
+
+def test_status_line_names_the_app_without_window_or_process_ids():
+    assert status_text("WeChat", "active", True) == "OpenProgram 正在操作 WeChat"
+    assert status_text("WeChat", "active", False) == "OpenProgram is using WeChat"
+    assert status_text("WeChat", "completed", True) == "OpenProgram 已结束操作 WeChat"
+    assert status_text("", "active", False) == "OpenProgram is using this app"
+    assert "34327" not in status_text("WeChat", "active", True)
+
+
+def test_language_follows_the_first_preferred_language():
+    assert prefers_chinese(["zh-Hans-CN", "en-US"])
+    assert not prefers_chinese(["en-US", "zh-Hans"])
+    assert not prefers_chinese([])
+
+
+def test_pointer_tag_names_the_action_never_the_text():
+    assert action_tag("window_press", False) == "Click"
+    assert action_tag("window_set_text", True) == "输入"
+    assert action_tag("window_scroll", False) == "Scroll"
+    assert action_tag("unknown", False) is None
+
+
+def test_pill_hangs_from_the_top_centre_of_the_window():
+    x, y = pill_origin(980, 650, 220)
+    assert x == (980 - 220) / 2
+    assert y == 650 - mac_indicator.PILL_TOP - mac_indicator.PILL_HEIGHT
+    # A window narrower than the pill keeps the pill on its left edge.
+    assert pill_origin(100, 650, 220)[0] == 4.0
+
+
+def test_pointer_glide_is_eased_bounded_and_lands_exactly():
+    start, end = (0.0, 0.0), (300.0, 400.0)
+    assert ease_point(start, end, 0) == start
+    assert ease_point(start, end, 1) == end
+    assert ease_point(start, end, 2) == end
+    quarter, half = ease_point(start, end, 0.25), ease_point(start, end, 0.5)
+    assert 0 < quarter[0] < 300 * 0.25  # slow start
+    assert half == (150.0, 200.0)
+    assert mac_indicator.TRAVEL_MIN_S <= travel_duration(start, start) <= mac_indicator.TRAVEL_MAX_S
+    assert travel_duration(start, (5000.0, 0.0)) == mac_indicator.TRAVEL_MAX_S
+
+
+def test_accent_is_a_single_cool_colour_constant():
+    red, green, blue = ACCENT
+    assert blue > red and blue > green
+
+
+def _fake_indicator():
+    placed = []
+    ripples = []
+    indicator = mac_indicator.Indicator.__new__(mac_indicator.Indicator)
+    indicator.appkit = SimpleNamespace(NSMakePoint=lambda x, y: (x, y))
+    indicator.marker = SimpleNamespace(setFrameOrigin_=placed.append)
+    indicator.reduce_motion = False
+    indicator.started = 0.0
+    indicator.tip = None
+    indicator.tip_is_idle = True
+    indicator.motion = None
+    indicator.action = None
+    indicator.action_bounds = None
+    indicator.shown_serial = 0
+    indicator._ripple = lambda: ripples.append(True)
+    return indicator, placed, ripples
+
+
+def test_restored_marker_appears_in_place_without_a_click_ripple():
+    indicator, placed, ripples = _fake_indicator()
+    indicator.tip = (100.0, 100.0)
+    indicator.set_action("window_press", {"x": 0, "y": 0, "width": 10, "height": 10})
+    indicator._move_pointer((300.0, 200.0), now=0.1)
+    assert indicator.tip == (300.0, 200.0)
+    assert indicator.motion is None
+    assert ripples == []
+
+
+def test_new_click_glides_then_ripples_once():
+    indicator, placed, ripples = _fake_indicator()
+    indicator.tip = (100.0, 100.0)
+    indicator.set_action("window_press", {"x": 0, "y": 0, "width": 10, "height": 10})
+    indicator._move_pointer((400.0, 100.0), now=5.0)
+    assert indicator.motion is not None
+    duration = indicator.motion[3]
+    indicator._move_pointer((400.0, 100.0), now=5.0 + duration / 2)
+    assert 100.0 < indicator.tip[0] < 400.0
+    assert ripples == []
+    indicator._move_pointer((400.0, 100.0), now=5.0 + duration)
+    assert indicator.tip == (400.0, 100.0)
+    assert indicator.motion is None
+    assert ripples == [True]
+    indicator._move_pointer((400.0, 100.0), now=6.0)
+    assert ripples == [True]
+
+
+def test_reduced_motion_snaps_without_ripple():
+    indicator, placed, ripples = _fake_indicator()
+    indicator.reduce_motion = True
+    indicator.tip = (100.0, 100.0)
+    indicator.set_action("window_press", {"x": 0, "y": 0, "width": 10, "height": 10})
+    indicator._move_pointer((400.0, 100.0), now=5.0)
+    assert indicator.tip == (400.0, 100.0)
+    assert ripples == []
