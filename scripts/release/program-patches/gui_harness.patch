+"""One model call through the runtime bound by a headless Agent method."""
+from __future__ import annotations
+
+from .call_state import _current_runtime
+
+
+def llm(prompt, **options):
+    runtime = _current_runtime.get()
+    if runtime is None:
+        raise RuntimeError("llm() requires a runtime supplied to an Agent method")
+    content = [{"type": "text", "text": prompt}] if isinstance(prompt, str) else prompt
+    result = runtime.exec(content=content, **options)
+    return result.get("text", result) if isinstance(result, dict) else result
+
+
+__all__ = ["llm"]
