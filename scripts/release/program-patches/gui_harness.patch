+"""gui_agent's time budget is a deadline, independent of clock-read counts."""
+from types import SimpleNamespace
+
+import pytest
+
+from gui_harness import main as module
+from gui_harness.tasks import capability_loop
+from gui_harness.tasks import result as result_module
+
+
+def _desktop_only(**_kwargs):
+    return {
+        "computer_use": {"available": True},
+        "browser_use": {"available": False},
+        "vm_use": {"available": False},
+    }
+
+
+def _no_conclusion(**_kwargs):
+    raise AssertionError("conclusion must not run after the deadline")
+
+
+@pytest.fixture
+def clock(monkeypatch):
+    """A clock that moves only when a stub advances it."""
+    now = {"wall": 1_000.0, "monotonic": 0.0}
+    monkeypatch.setattr(module, "time", SimpleNamespace(
+        time=lambda: now["wall"], monotonic=lambda: now["monotonic"],
+    ))
+    monkeypatch.setattr(capability_loop, "capability_status", _desktop_only)
+    monkeypatch.setattr(result_module, "save_workflow_record", lambda *_a, **_k: None)
+    monkeypatch.setattr(result_module, "conclusion", _no_conclusion)
+    return now
+
+
+def test_timeout_wins_when_the_last_decision_also_crosses_the_deadline(clock, monkeypatch):
+    # Each rejected terminal costs 0.2 s. The sixth decision is the last one
+    # allowed (max_steps * 3 + 3) and also crosses the 1.1 s budget.
+    def reject(_decision, _history):
+        clock["monotonic"] += 0.2
+        return {"accepted": False, "reason": "unsupported terminal"}
+
+    monkeypatch.setattr(capability_loop, "plan_next_capability",
+                        lambda **_kwargs: {"call": "terminal", "args": {"status": "succeeded"}})
+    monkeypatch.setattr(capability_loop, "validate_terminal_decision", reject)
+
+    result = module.gui_agent(task="inspect", max_steps=1, max_seconds=1.1, runtime=object())
+
+    assert result["iterations"] == 6
+    assert result["status"] == "failed"
+    assert result["reason_code"] == "timeout"
+    assert "Conclusion skipped" in result["issues"]
+
+
+def test_wall_clock_change_does_not_move_the_deadline(clock, monkeypatch):
+    def act(*_args, **_kwargs):
+        clock["wall"] -= 3_600.0      # system clock set back an hour
+        clock["monotonic"] += 2.0     # two real seconds pass
+        return {"status": "applied", "success": True}
+
+    monkeypatch.setattr(capability_loop, "plan_next_capability",
+                        lambda **_kwargs: {"call": "computer_use", "args": {"task": "inspect"}})
+    monkeypatch.setattr(capability_loop, "call_capability", act)
+
+    result = module.gui_agent(task="inspect", max_steps=5, max_seconds=1, runtime=object())
+
+    assert result["reason_code"] == "timeout"
+    assert result["steps_taken"] == 1
+    assert result["total_time"] == 2.0
